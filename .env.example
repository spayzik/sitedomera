# Telegram bot for lead forms (optional)
# 1. Create bot via @BotFather -> get token
# 2. Get your chat id via @userinfobot or getUpdates
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Резервный приём заявок, если Telegram недоступен (POST JSON с лидом)
VITE_LEAD_FALLBACK_URL=

# Яндекс.Метрика: числовой ID счётчика (пусто = скрипт не подключается)
VITE_YM_ID=
