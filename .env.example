# Production profile defaults to 114347066. Override only for an approved replacement.
VITE_YM_ID=
# Separate test counter. The staging profile ignores the production ID.
VITE_YM_STAGING_ID=
# Applies to staging. Production profile enables Webvisor and keeps consent.
VITE_YM_WEBVISOR=0
VITE_AVITO_PROFILE_URL=
# Configure an isolated HTTPS /api/lead endpoint for the staging profile.
VITE_DEKORAY_STAGING_LEAD_API=
# Separate HTTPS /api/payment must report sandbox readiness.
VITE_DEKORAY_STAGING_PAYMENT_API=
# Enable only when the host serves a validated same-origin inventory snapshot.
VITE_DEKORAY_INVENTORY=
