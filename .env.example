# Production Metrika ID, blank disables tracking
VITE_YM_ID=
# Separate test counter. The staging profile ignores the production ID.
VITE_YM_STAGING_ID=
# Enable after masking and the provider recording policy are verified.
VITE_YM_WEBVISOR=0
VITE_AVITO_PROFILE_URL=
# Configure an isolated HTTPS /api/lead endpoint for the staging profile.
VITE_DEKORAY_STAGING_LEAD_API=
# Enable only when the host serves a validated same-origin inventory snapshot.
VITE_DEKORAY_INVENTORY=
