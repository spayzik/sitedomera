Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

RewriteCond %{THE_REQUEST} "\s/+((?:[a-z0-9-]+/)*)index\.html(?:[?\s])"
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^((?:[a-z0-9-]+/)*)index\.html$ https://xn--80ahdrdyo.xn--p1ai/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.xn--80ahdrdyo\.xn--p1ai(?::[0-9]+)?$ [NC]
RewriteRule ^ https://xn--80ahdrdyo.xn--p1ai%{REQUEST_URI} [R=301,L,NE]

# Enable this configuration only after verifying Apache HTTPS=on for external HTTPS.
# Use ispmanager for the scheme redirect if the reverse proxy terminates TLS.
RewriteCond %{HTTP_HOST} ^xn--80ahdrdyo\.xn--p1ai(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://xn--80ahdrdyo.xn--p1ai%{REQUEST_URI} [R=308,L,NE]

RewriteRule ^api/lead$ api/lead.php [END]
